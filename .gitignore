config.bat
node_modules

# ==========================================
# Security and generated-file exclusions
# ==========================================

# Environment variables and secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.sample
!**/.env.template

# Dependencies
**/node_modules/
**/.pnp/
**/.pnp.*
**/.yarn/cache/

# Build outputs
**/.next/
**/dist/
**/build/
**/out/
**/coverage/
**/.turbo/

# Deployment and IDE files
**/.vercel/
**/.vscode/
**/.idea/

# Logs and temporary files
**/*.log
**/logs/
**/tmp/
**/temp/

# Sensitive credentials and private keys
**/serviceKey.json
**/*.pem

# Operating system files
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# TypeScript cache
**/*.tsbuildinfo
